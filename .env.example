# Postgres connection string.
#   Local runs (API on your machine, DB in docker): localhost:5433
#   Inside docker-compose (set in docker-compose.yml): db:5432
DATABASE_URL=postgresql://registry:registry@localhost:5433/registry
# DATABASE_URL=postgresql://registry:registry@db:5432/registry

# Where AI systems are discovered from: "mock" (fake data) or "aws" (real account)
DISCOVERY_MODE=mock

# Comma-separated AWS regions to crawl
AWS_REGIONS=us-east-1

# CloudWatch log group prefix that holds agent logs
AGENT_LOG_PREFIX=/ai/agents/

# How far back to read agent logs, in hours (720 = 30 days)
LOG_LOOKBACK_HOURS=720

# Assumed monthly request volume when real usage is unknown
DEFAULT_MONTHLY_REQUESTS=10000

# On API startup in mock mode, run discovery once if the registry is empty (true/false)
AUTO_DISCOVER=true

# Comma-separated origins allowed to call the API (the frontend)
CORS_ORIGINS=http://localhost:3000

# Frontend: API URL as seen from the browser (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
