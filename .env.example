# Postgres connection string.
#   Local runs (API on your machine, DB in docker): localhost:5433
#   Inside docker-compose (set in docker-compose.yml): db:5432
DATABASE_URL=postgresql://registry:registry@localhost:5433/registry
# DATABASE_URL=postgresql://registry:registry@db:5432/registry

# Where AI systems are discovered from: "mock" (fake data) or "aws" (real account)
DISCOVERY_MODE=mock

# Comma-separated AWS regions to crawl
AWS_REGIONS=us-east-1

# CloudWatch log group prefix that holds agent logs
AGENT_LOG_PREFIX=/ai/agents/

# How far back to read agent logs, in hours (720 = 30 days)
LOG_LOOKBACK_HOURS=720

# Assumed monthly request volume when real usage is unknown
DEFAULT_MONTHLY_REQUESTS=10000

# On API startup in mock mode, run discovery once if the registry is empty (true/false)
AUTO_DISCOVER=true

# Let an LLM plan the crawl and judge what the rules are unsure about (true/false). Costs LLM tokens.
LLM_ENABLED=false

# Where the crawler's LLM runs: bedrock (keeps code and config in AWS), or gemini or groq (outside AWS)
LLM_PROVIDER=bedrock

# The crawler's model; unset means the provider's default: au.anthropic.claude-haiku-5-5 (a Bedrock inference
# profile, which must exist in the first region of AWS_REGIONS), gemini-3-flash-preview or openai/gpt-oss-120b
# LLM_MODEL_ID=au.anthropic.claude-haiku-5-5

# Models `cli evaluate` compares, the default first; another is worth switching to only if it is clearly better.
# Unset means the provider's pair: Claude Haiku and Sonnet 5.5, Gemini 3 Flash and 3.1 Pro, or gpt-oss-120b and 20b
# LLM_EVAL_MODELS=au.anthropic.claude-haiku-5-5,au.anthropic.claude-sonnet-5-5

# API keys, needed only for their provider. Put them in backend/.env, which is never committed
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Most LLM calls the planner may make in one crawl; the rules cover whatever is left
LLM_MAX_STEPS=12

# Comma-separated origins allowed to call the API (the frontend)
CORS_ORIGINS=http://localhost:3000

# Frontend: API URL as seen from the browser (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend server side: API URL as seen from the Next.js server (http://api:8000 inside docker)
INTERNAL_API_URL=http://localhost:8000
